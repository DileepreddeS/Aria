# Alembic only. Copy to .env.migrate and fill in.
#
# aria_migrate owns the tables and, through its maintenance policy, is not subject
# to tenant isolation. Keeping it out of .env means a process that serves requests
# cannot pick it up, and aria_core.config.assert_no_migration_credentials() refuses
# to start one that can see it.
ARIA_MIGRATE_DATABASE_URL=postgresql+asyncpg://aria_migrate:CHANGE_ME@127.0.0.1:5433/aria
