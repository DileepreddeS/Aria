# ARIA local development configuration — NAMES ONLY, never real values.
# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---- runtime ----
ARIA_ENV=dev                      # dev | ci | staging | prod

# ---- database ----
# The API connects as aria_app, which is subject to row-level security.
ARIA_DATABASE_URL=postgresql+asyncpg://aria_app:CHANGE_ME@127.0.0.1:5433/aria
# Alembic connects as aria_migrate (owns nothing, can migrate).
ARIA_MIGRATE_DATABASE_URL=postgresql+asyncpg://aria_migrate:CHANGE_ME@127.0.0.1:5433/aria

# ---- envelope encryption (S2 fields) ----
# Dev KMS root key file. Lives outside the repo. Created by `./tasks.ps1 kms-init`.
ARIA_DEV_KMS_KEY_PATH=%APPDATA%\aria\dev-kms-root.key

# ---- LLM gateway ----
# Shared service token the API presents to the gateway. Random 32+ bytes, base64.
ARIA_LLM_GATEWAY_URL=http://127.0.0.1:8081
ARIA_LLM_GATEWAY_SERVICE_TOKEN=CHANGE_ME
# Bind address for the gateway. Must stay on loopback (SECURITY.md §2.5).
ARIA_LLM_GATEWAY_BIND_HOST=127.0.0.1
ARIA_LLM_GATEWAY_BIND_PORT=8081

# ---- ApplyTask signing (Ed25519) ----
# Private key is API-side only. The Runner holds public keys by kid.
ARIA_APPLY_TASK_SIGNING_KEY_PATH=%APPDATA%\aria\apply-task-signing.key
ARIA_APPLY_TASK_SIGNING_KID=dev-1

# ---- observability ----
ARIA_OTEL_EXPORTER=console        # console | none
ARIA_LOG_LEVEL=INFO

# No LLM provider keys yet. They arrive in Phase 2 and only ever live in the
# llm_gateway service's own environment (SECURITY.md §13).
