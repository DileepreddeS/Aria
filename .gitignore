# ---- secrets and personal data (never committed) ----
.env
.env.*
!.env.example
!.env.migrate.example
private/
*.pem
*.key
secrets/
# Imported candidate data. data/ itself is tracked: data/seed/ holds the skill
# taxonomy, which the loader reads at import time and ~12 test files depend on, so
# ignoring the whole directory would break a fresh clone.
data/candidates/
data/private/

# ---- python ----
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
build/
dist/

# ---- local artifacts ----
artifacts/
# Each eval run's report; only the baseline beside it is tracked.
evals/resume/reports/
*.log
.coverage
htmlcov/

# ---- node (apps/web, later phases) ----
node_modules/
.next/

# ---- editors / os ----
.vscode/
.idea/
Thumbs.db
desktop.ini
CLAUDE.md
.claude/
